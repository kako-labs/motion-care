<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <!-- The Pleos speech SDK adds this for its server mode. Only the on-device mode is used. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <application android:name=".app.MotionCareApplication"
        android:allowBackup="false" android:icon="@drawable/ic_launcher"
        android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:label="@string/app_name"
        android:supportsRtl="true" android:theme="@style/Theme.MotionCare">
        <activity android:name=".app.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".app.TripRecordingService" android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
